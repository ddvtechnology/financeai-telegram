# Token criado em https://t.me/BotFather com /newbot
TELEGRAM_BOT_TOKEN=
# Obtenha enviando /id ao seu bot (sem precisar ainda configurar o proprietário)
TELEGRAM_OWNER_ID=
# API keys criadas em https://build.nvidia.com/models
# A mesma chave pode ser usada para os dois modelos se tiver acesso
NVIDIA_KEY_LIGHTNING=
NVIDIA_KEY_ULTRA=
TIMEZONE=America/Recife
# Hora (0-23) do resumo matinal diário e do relatório mensal automático
MORNING_HOUR=8
# Alertas de bateria do celular (exigem o app Termux:API e: pkg install termux-api)
# BATTERY_ALERTS=0 desliga; BATTERY_LEVELS são as porcentagens de aviso; BATTERY_FULL_ALERT=0 desliga o aviso de 100%
BATTERY_ALERTS=1
BATTERY_LEVELS=20,10,5
BATTERY_FULL_ALERT=1
# Segundos que o bot espera cada resposta da IA (modelos gratuitos podem demorar; mínimo 30)
AI_TIMEOUT=180
